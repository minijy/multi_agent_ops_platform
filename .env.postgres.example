APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8100
LOG_LEVEL=INFO
APP_API_KEY=replace-with-a-long-random-secret

CONTROL_PLANE_BACKEND=postgres
SESSION_EVENT_BACKEND=postgres
POSTGRES_DSN=postgresql://ops_agent:change-me@127.0.0.1:5432/ops_agent
PLATFORM_DB_PATH=data/platform.sqlite3
SESSION_EVENT_PATH=data/session_events.sqlite3
ATTACHMENT_PATH=data/attachments
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=20
ATTACHMENT_MAX_IMAGE_PIXELS=40000000
SKILLS_PATHS=skills
MCP_CONFIG_PATH=config/mcp_servers.json

MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-sol
OPENAI_API_KEY=replace-me
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
MODEL_BACKOFF_BASE_SECONDS=1
MODEL_RATE_LIMIT_COOLDOWN_SECONDS=30
ZAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL_NAME=glm-5.2
ZHIPU_VISION_MODEL_NAME=glm-4.6v-flash
# Optional. Leave unset unless the selected model/workload explicitly needs it.
# MODEL_TEMPERATURE=0

MAX_TOOL_STEPS=8
RUN_TOKEN_BUDGET=30000
RUNTIME_GOVERNANCE_PATH=data/runtime_governance.sqlite3
SUBAGENT_WORKER_COUNT=4
SUBAGENT_QUEUE_BACKEND=db
SUBAGENT_LEASE_SECONDS=30
SUBAGENT_LEASE_RENEW_SECONDS=10
SUBAGENT_WORKER_POLL_SECONDS=0.5
SUBAGENT_MAX_ATTEMPTS=3
SUBAGENT_WORKER_ID=
SUBAGENT_MAX_DEPTH=3
SUBAGENT_DEFAULT_TIMEOUT_SECONDS=120
SUBAGENT_DEFAULT_TOKEN_BUDGET=8000
SANDBOX_WORKSPACE_ROOT=.
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_FULL_ACCESS_ENABLED=false

KNOWLEDGE_BACKEND=qdrant
QDRANT_URL=https://replace-me.qdrant.io
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=rag_chunks_multilingual_minilm_v1
QDRANT_TENANT_ID=replace-me
QDRANT_KNOWLEDGE_BASE_ID=replace-me
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_TOP_K=5
