APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8100
LOG_LEVEL=INFO
APP_API_KEY=replace-with-a-long-random-secret
APP_REPLICA_COUNT=1
JWT_SECRET=replace-with-a-shared-random-signing-secret
JWT_REQUIRED=true
JWT_ISSUER=multi-agent-ops-platform
JWT_AUDIENCE=multi-agent-ops-platform-api
ACCOUNT_ACCESS_TOKEN_MINUTES=15
ACCOUNT_REFRESH_TOKEN_DAYS=7
ACCOUNT_MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
# 仅用于空租户创建第一个管理员；初始化后应轮换并从运行环境移除。
ACCOUNT_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-bootstrap-secret

CONTROL_PLANE_BACKEND=postgres
SESSION_EVENT_BACKEND=postgres
POSTGRES_DSN=postgresql://ops_agent:change-me@127.0.0.1:5432/ops_agent
PLATFORM_DB_PATH=data/platform.sqlite3
SESSION_EVENT_PATH=data/session_events.sqlite3
ATTACHMENT_PATH=data/attachments
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=20
ATTACHMENT_MAX_IMAGE_PIXELS=40000000
SKILLS_PATHS=skills
MCP_CONFIG_PATH=config/mcp_servers.json

# 模型 Provider、模型名称、Base URL 和 API Key 在“系统设置 → 模型配置”中管理。
MODEL_SECRETS_PATH=data/model_secrets.json
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
MODEL_BACKOFF_BASE_SECONDS=1
MODEL_RATE_LIMIT_COOLDOWN_SECONDS=30

MAX_TOOL_STEPS=8
RUN_TOKEN_BUDGET=30000
RUNTIME_GOVERNANCE_PATH=data/runtime_governance.sqlite3
CONNECTION_DEFINITIONS_PATH=data/connections.json
CONNECTION_SECRETS_PATH=data/connection_secrets.json
TOOL_BINDINGS_PATH=data/tool_bindings.json
DEFAULT_TENANT_ID=tenant-a
SUBAGENT_WORKER_COUNT=4
SUBAGENT_QUEUE_BACKEND=db
SUBAGENT_LEASE_SECONDS=30
SUBAGENT_LEASE_RENEW_SECONDS=10
SUBAGENT_WORKER_POLL_SECONDS=0.5
SUBAGENT_MAX_ATTEMPTS=3
SUBAGENT_WORKER_ID=
SUBAGENT_MAX_DEPTH=3
SUBAGENT_DEFAULT_TIMEOUT_SECONDS=120
SUBAGENT_DEFAULT_TOKEN_BUDGET=8000
ANALYST_PARALLEL_LIMIT=3
MEMORY_ENABLED=true
MEMORY_BACKEND=postgres
MEMORY_DB_PATH=data/memory.sqlite3
# pgvector 不可用时改为 local；也可改为 qdrant。
MEMORY_SEMANTIC_BACKEND=pgvector
MEMORY_EMBEDDING_PROVIDER=sentence_transformers
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBEDDING_DIMENSIONS=384
MEMORY_QDRANT_COLLECTION=agent_memory_items_v1
QDRANT_URL=
QDRANT_API_KEY=
MEMORY_SNAPSHOT_LIMIT=8
MEMORY_SNAPSHOT_MAX_CHARS=2400
MEMORY_RELEVANCE_THRESHOLD=0.12
MEMORY_DEFAULT_EXPIRY_DAYS=365
MEMORY_AUTO_EXTRACT_ENABLED=true
SANDBOX_WORKSPACE_ROOT=.
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_FULL_ACCESS_ENABLED=false
AGENT_STREAM_MAX_CONCURRENCY=32
