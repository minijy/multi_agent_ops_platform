# Development defaults: no PostgreSQL or model API is required.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8100
LOG_LEVEL=INFO
APP_API_KEY=

CONTROL_PLANE_BACKEND=sqlite
SESSION_EVENT_BACKEND=sqlite
PLATFORM_DB_PATH=data/platform.sqlite3
SESSION_EVENT_PATH=data/session_events.sqlite3
ATTACHMENT_PATH=data/attachments
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=20
ATTACHMENT_MAX_IMAGE_PIXELS=40000000
SKILLS_PATHS=skills
MCP_CONFIG_PATH=config/mcp_servers.json

# Switch persistence backends to postgres after PostgreSQL is ready.
POSTGRES_DSN=postgresql://ops_agent:ops_agent@127.0.0.1:5432/ops_agent

# Read-only Amazon finance analytics database used by the BI query agent.
ANALYTICS_DSN=
ANALYTICS_STATEMENT_TIMEOUT_MS=5000

# mock runs fully offline. Change to openai only when an API key is configured.
MODEL_PROVIDER=mock
MODEL_NAME=gpt-5.6-sol
OPENAI_API_KEY=
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
MODEL_BACKOFF_BASE_SECONDS=1
MODEL_RATE_LIMIT_COOLDOWN_SECONDS=30
# 智谱官方 SDK；启用时将 MODEL_PROVIDER 改为 zhipu。
ZAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL_NAME=glm-5.2
ZHIPU_VISION_MODEL_NAME=glm-4.6v-flash
# Optional. Leave unset for model-native defaults; do not force sampling settings globally.
# MODEL_TEMPERATURE=0

MAX_TOOL_STEPS=8
RUN_TOKEN_BUDGET=30000
CONTEXT_WINDOW_ENABLED=true
CONTEXT_KEEP_RECENT_USER_TURNS=16
CONTEXT_MAX_MESSAGES=64
CONTEXT_MAX_CHARS=80000
CONTEXT_TOOL_MAX_ROWS=12
CONTEXT_TOOL_MAX_CHARS=4000
RUNTIME_OVERRIDES_PATH=data/runtime_overrides.json
AGENT_DEFINITIONS_PATH=data/agent_definitions.json
RUNTIME_GOVERNANCE_PATH=data/runtime_governance.sqlite3
SUBAGENT_QUEUE_BACKEND=inline
SUBAGENT_WORKER_COUNT=4
SUBAGENT_MAX_DEPTH=3
SUBAGENT_DEFAULT_TIMEOUT_SECONDS=120
SUBAGENT_DEFAULT_TOKEN_BUDGET=8000
SUBAGENT_LEASE_SECONDS=30
SUBAGENT_LEASE_RENEW_SECONDS=10
SUBAGENT_WORKER_POLL_SECONDS=0.5
SUBAGENT_MAX_ATTEMPTS=3
SUBAGENT_WORKER_ID=
SANDBOX_WORKSPACE_ROOT=.
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_FULL_ACCESS_ENABLED=false
RUNTIME_METRICS_PATH=data/runtime_metrics.sqlite3

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRED=false
OTEL_SERVICE_NAME=ops-agent
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Existing Qdrant RAG integration. mock keeps local tests deterministic.
KNOWLEDGE_BACKEND=mock
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks_multilingual_minilm_v1
QDRANT_TENANT_ID=
QDRANT_KNOWLEDGE_BASE_ID=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_TOP_K=5
