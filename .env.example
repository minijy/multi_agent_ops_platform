# Development defaults. PostgreSQL is required for all persistence.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8100
LOG_LEVEL=INFO
APP_API_KEY=
APP_REPLICA_COUNT=1

POSTGRES_DSN=postgresql://ops_agent:ops_agent@127.0.0.1:5432/ops_agent
AUTH_SECRET_PATH=data/platform.auth-secret
ATTACHMENT_PATH=data/attachments
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=20
ATTACHMENT_MAX_IMAGE_PIXELS=40000000
SKILLS_PATHS=skills
MCP_CONFIG_PATH=config/mcp_servers.json

# 数据查询连接在管理界面的“连接器”中配置。
ANALYTICS_STATEMENT_TIMEOUT_MS=5000

# 模型 Provider、模型名称、Base URL 和 API Key 在“系统设置 → 模型配置”中管理。
MODEL_SECRETS_PATH=data/model_secrets.json
# 下列参数只控制服务端请求容错。
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
MODEL_BACKOFF_BASE_SECONDS=1
MODEL_RATE_LIMIT_COOLDOWN_SECONDS=30

MAX_TOOL_STEPS=8
RUN_TOKEN_BUDGET=30000
# 上下文窗口和意图识别开关由管理页面保存到运行时覆盖文件。
RUNTIME_OVERRIDES_PATH=data/runtime_overrides.json
AGENT_DEFINITIONS_PATH=data/agent_definitions.json
CONNECTION_DEFINITIONS_PATH=data/connections.json
CONNECTION_SECRETS_PATH=data/connection_secrets.json
TOOL_BINDINGS_PATH=data/tool_bindings.json
DEFAULT_TENANT_ID=tenant-a
KNOWLEDGE_SPACES_PATH=data/knowledge_spaces.json
# search_knowledge 默认调用电商 GraphRAG 的 /v1/retrieve。可设为 wenshu 回退旧协议。
KNOWLEDGE_API_BACKEND=ecommerce_graphrag
KNOWLEDGE_API_URL=http://127.0.0.1:8000
# GraphRAG 当前未开启鉴权时可留空；wenshu 协议必填。
KNOWLEDGE_API_TOKEN=
SUBAGENT_QUEUE_BACKEND=inline
SUBAGENT_WORKER_COUNT=4
SUBAGENT_MAX_DEPTH=3
SUBAGENT_DEFAULT_TIMEOUT_SECONDS=120
SUBAGENT_DEFAULT_TOKEN_BUDGET=8000
SUBAGENT_LEASE_SECONDS=30
SUBAGENT_LEASE_RENEW_SECONDS=10
SUBAGENT_WORKER_POLL_SECONDS=0.5
SUBAGENT_MAX_ATTEMPTS=3
SUBAGENT_WORKER_ID=
INTENT_ROUTING_PARALLEL_LIMIT=3
# 三级路由：硬匹配 -> Qwen 小模型 -> Coordinator 大模型。
# 开关可在“系统设置”中修改；小模型服务使用 OpenAI-compatible API。
INTENT_ROUTING_ENABLED=false
INTENT_ROUTING_BASE_URL=http://127.0.0.1:8001/v1
INTENT_ROUTING_API_KEY=
INTENT_ROUTING_MODEL=qwen3-1.7b-intent-router
INTENT_ROUTING_TIMEOUT_SECONDS=3
INTENT_ROUTING_HISTORY_MESSAGES=8
MEMORY_ENABLED=true
MEMORY_SEMANTIC_BACKEND=local
MEMORY_EMBEDDING_PROVIDER=hash
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBEDDING_DIMENSIONS=384
MEMORY_QDRANT_COLLECTION=agent_memory_items_v1
# 仅当长期记忆选择 qdrant 语义后端时使用。知识库请在页面配置连接器。
QDRANT_URL=
QDRANT_API_KEY=
MEMORY_SNAPSHOT_LIMIT=8
MEMORY_SNAPSHOT_MAX_CHARS=2400
MEMORY_RELEVANCE_THRESHOLD=0.12
MEMORY_DEFAULT_EXPIRY_DAYS=365
MEMORY_AUTO_EXTRACT_ENABLED=true
SANDBOX_WORKSPACE_ROOT=.
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_FULL_ACCESS_ENABLED=false
AGENT_STREAM_MAX_CONCURRENCY=32

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRED=false
ACCOUNT_ACCESS_TOKEN_MINUTES=15
ACCOUNT_REFRESH_TOKEN_DAYS=7
ACCOUNT_MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
ACCOUNT_BOOTSTRAP_TOKEN=
OTEL_SERVICE_NAME=ops-agent
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
